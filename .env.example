# 复制为 .env 后按环境填写；.env 不入库。
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL（语义库 + 业务样例库同实例）
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=semantic_layer
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/semantic_layer

# 只读执行
QUERY_TIMEOUT_MS=30000
MAX_RESULT_ROWS=1000